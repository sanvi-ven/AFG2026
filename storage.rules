rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Job completion photos. Same trust model as firestore.rules: this app
    // has no real Firebase Auth session for owner/client/employee today, so
    // this is permissive by necessity rather than checking an unverifiable role.
    // Still open, but no longer an arbitrary-file-dump target: writes must be
    // a reasonably-sized image. request.resource is null on delete, so that's
    // split out separately.
    match /job_photos/{workId}/{phase}/{fileName} {
      allow read: if true;
      allow create, update: if request.resource.size < 10 * 1024 * 1024
                             && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
