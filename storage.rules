rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Not actually provisioned today (zero buckets exist on this project —
    // see CLAUDE.md) so this file is currently inert, but kept correct for
    // whenever it is. Real Firebase Auth exists as of 2026-09-01 — write
    // access is staff-only now, matching firestore.rules' equivalent
    // collections, instead of the pre-auth "permissive by necessity" design
    // this file predates. Read stays public: job photos are already
    // viewable through the app without restriction elsewhere.
    match /job_photos/{workId}/{phase}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null &&
                             request.auth.token.role in ['owner', 'employee'] &&
                             request.resource.size < 10 * 1024 * 1024 &&
                             request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.token.role in ['owner', 'employee'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
