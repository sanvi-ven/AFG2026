APP_NAME=Anchor
API_V1_PREFIX=/api/v1
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_SERVICE_ACCOUNT_PATH=service-account.json
USE_MOCK_FIRESTORE=true
DEV_AUTH_BYPASS=true

# comma-separated list of allowed CORS origins for the deployed frontend
ALLOWED_ORIGINS_RAW=https://anchor-orpin.vercel.app

# set true to additionally allow any localhost/127.0.0.1 origin (any port)
# for running the Flutter web app locally against this backend — leave
# unset/false on any real deployment (Cloud Run never sets this)
ALLOW_LOCALHOST_CORS=true

# comma-separated list of emails allowed to claim the "owner" role on signup
OWNER_EMAILS_RAW=immc17289@gmail.com

# base64-encoded service-account.json contents; only needed on hosts (Cloud
# Run) with no persistent filesystem to check the file into. Leave unset for
# local dev, which falls back to GOOGLE_SERVICE_ACCOUNT_PATH above.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Resend (email) - https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@rplandscaping.org

# Cloudinary (photo storage) - https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio (SMS) - https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
