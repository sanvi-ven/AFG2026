APP_NAME=Anchor
API_V1_PREFIX=/api/v1
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_SERVICE_ACCOUNT_PATH=service-account.json
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
USE_MOCK_FIRESTORE=true
DEV_AUTH_BYPASS=true

# base64-encoded service-account.json contents; only needed on hosts (Cloud
# Run) with no persistent filesystem to check the file into. Leave unset for
# local dev, which falls back to GOOGLE_SERVICE_ACCOUNT_PATH above.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Resend (email) - https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Cloudinary (photo storage) - https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio (SMS) - https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
